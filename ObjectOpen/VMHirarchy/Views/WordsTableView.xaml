<UserControl x:Class="VMHirarchy.Views.WordsTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMHirarchy.Views"
             xmlns:vm="clr-namespace:VMHirarchy.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance IsDesignTimeCreatable=False, Type={x:Type vm:WordsTableVM}}">

    <UserControl.DataContext>
        <StaticResource ResourceKey="WordsTableVM"/>
    </UserControl.DataContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Parent.PluginsNames}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Installed plugins"
                                    Binding="{Binding}"/>
            </DataGrid.Columns>
        </DataGrid>

        <local:NewWordButtonView Grid.Row="1"/>
        
    </Grid>
</UserControl>
